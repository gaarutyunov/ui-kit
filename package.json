{
  "name": "@gaarutyunov/ui-kit",
  "version": "0.1.0",
  "description": "A universal, zero-dependency Web Components UI kit. Works in vanilla JS, React, Astro, Vue, Svelte — any frontend. Geist-inspired pure-black dark theme.",
  "type": "module",
  "license": "MIT",
  "author": "German Arutyunov <germanarutyunov@gmail.com>",
  "homepage": "https://gaarutyunov.github.io/ui-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaarutyunov/ui-kit.git"
  },
  "keywords": [
    "ui-kit",
    "web-components",
    "custom-elements",
    "design-system",
    "vanilla-js",
    "react",
    "astro",
    "storybook",
    "framework-agnostic"
  ],
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens.css": "./src/tokens/tokens.css",
    "./components/*": "./src/components/*"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "src/index.js",
    "src/components/**/*.js",
    "*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/web-components-vite": "8.6.18",
    "storybook": "8.6.18",
    "vite": "^5.4.11"
  },
  "overrides": {
    "storybook": "8.6.18",
    "@storybook/core": "8.6.18",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/blocks": "8.6.18"
  }
}
